# ============================================================
#  配置模板 —— 复制成 application-dev.yml 后改成你自己的值
#
#    cp application-dev.yml.example application-dev.yml
#
#  真正的 application-dev.yml 已被 .gitignore 排除，不会被提交。
# ============================================================
sky:
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    host: localhost
    port: 3306
    database: sky_take_out
    username: root
    password: 你的MySQL密码

  # 阿里云 OSS：项目已改为把图片存到本机磁盘，这里不再需要。
  # 保留这一段是为了兼容原有的配置结构，留占位值即可。
  alioss:
    endpoint: oss-cn-你的地域.aliyuncs.com
    access-key-id: 你的AccessKeyId
    access-key-secret: 你的AccessKeySecret
    bucket-name: 你的Bucket名称

  # 图片上传的落盘位置，不依赖任何云服务
  # 文件写到 dir 目录下，通过 url-prefix + 文件名 访问
  upload:
    dir: upload
    url-prefix: /images

  redis:
    host: localhost
    port: 6379
    password: 你的Redis密码
    database: 10

  # 微信小程序：只有用户端登录（code 换 openid）和微信支付会用
  # 本仓库只做管理端，这两个值留占位即可
  wechat:
    appid: 你的小程序AppID
    secret: 你的小程序AppSecret
